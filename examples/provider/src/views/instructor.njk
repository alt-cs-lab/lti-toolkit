<!DOCTYPE html>
<html lang="en">
  <head>
    <title>{{ title }}</title>
  </head>
  <body>
    <main>
        <h1>LTI Toolkit Example - Instructor View</h1>
        {% if message %}
        <p style="color: green">{{ message }}
        {% endif %}
        {% if error %}
        <p style="color: red">{{ error }}
        {% endif %}
        <p><b>Logged in as: </b>{{ launchData.user_name | d("Anonymous Instructor", true) }} &lt;{{ launchData.user_email | d("no email", true) }}&gt;</p>
        {% if launchData.launch_type == "lti1.3" %}
          <h2>LTI 1.3 Assignment and Grade Services (AGS)</h2>
          {% if agsError %}
            <p style="color: red">{{ agsError }}</p>
          {% else %}
            {% if lineItem %}
              <h3>Line Item Info</h3>
              <ul>
                <li><b>Label: </b> {{ lineItem.label }}</li>
                <li><b>Score Maximum: </b> {{ lineItem.scoreMaximum }}</li>
              </ul>
            {% endif %}
            {% if results %}
              <h3>Current Results</h3>
              {% if results.length == 0 %}
                <p>No results on file.</p>
              {% else %}
                <table border="1" cellpadding="4">
                  <tr>
                    <th>User ID</th>
                    <th>Score</th>
                    <th>Max Score</th>
                    <th>Comment</th>
                  </tr>
                  {% for result in results %}
                    <tr>
                      <td>{{ result.userId }}</td>
                      <td>{{ result.resultScore }}</td>
                      <td>{{ result.resultMaximum }}</td>
                      <td>{{ result.comment | d("—", true) }}</td>
                    </tr>
                  {% endfor %}
                </table>
              {% endif %}
            {% endif %}
            {% if lineItems %}
              <h3>All Line Items in Course</h3>
              {% if lineItems.length == 0 %}
                <p>No line items found.</p>
              {% else %}
                <table border="1" cellpadding="4">
                  <tr>
                    <th>Label</th>
                    <th>Max Score</th>
                    <th>Resource ID</th>
                    <th>Tag</th>
                    <th>Update</th>
                  </tr>
                  {% for item in lineItems %}
                    <tr>
                      <td>{{ item.label }}</td>
                      <td>{{ item.scoreMaximum }}</td>
                      <td>{{ item.resourceId }}</td>
                      <td>{{ item.tag }}</td>
                      <td>
                        <form method="POST" action="/instructor/lineitem/update">
                          <input type="hidden" name="lineitem_id" value="{{ item.id }}">
                          <label>Label: <input type="text" name="label" value="{{ item.label }}" required></label>
                          <label>Max Score: <input type="number" name="scoreMaximum" value="{{ item.scoreMaximum }}" step="any" required></label>
                          <label>Resource ID: <input type="text" name="resourceId" value="{{ item.resourceId }}"></label>
                          <label>Tag: <input type="text" name="tag" value="{{ item.tag }}"></label>
                          <label>Start (your local time): <input type="datetime-local" name="startDateTime" data-utc="{{ item.startDateTime }}"></label>
                          <label>End (your local time): <input type="datetime-local" name="endDateTime" data-utc="{{ item.endDateTime }}"></label>
                          <input type="submit" value="Update Line Item">
                        </form>
                      </td>
                    </tr>
                  {% endfor %}
                </table>
              {% endif %}
              <h3>Post a Grade</h3>
              {% set roster = courses[launchData.course_id].students %}
              {% if lineItems.length == 0 %}
                <p>No line items available to grade yet. Create one below.</p>
              {% elif not roster %}
                <p>No students have launched this course yet, so there's no one to grade. Have a student launch the tool first.</p>
              {% else %}
                <form method="POST" action="/instructor/lineitem/grade">
                  <label for="grade-lineitem"><b>Line Item: </b></label>
                  <select id="grade-lineitem" name="lineitem_url" required>
                    {% for item in lineItems %}
                      <option value="{{ item.id }}">{{ item.label }} (max {{ item.scoreMaximum }})</option>
                    {% endfor %}
                  </select>
                  <br>
                  <label for="grade-student"><b>Student: </b></label>
                  <select id="grade-student" name="user_lis13_id" required>
                    {% for email, student in roster %}
                      {% if student.lis13_id %}
                        <option value="{{ student.lis13_id }}">{{ student.name }} ({{ student.email }})</option>
                      {% endif %}
                    {% endfor %}
                  </select>
                  <br>
                  <label for="grade-score"><b>Score: </b></label>
                  <input type="number" id="grade-score" name="grade" min="0" max="1" step="0.01" required>
                  <br>
                  <label for="grade-activityProgress"><b>Activity Progress: </b></label>
                  <select id="grade-activityProgress" name="activityProgress">
                    <option value="Submitted" selected>Submitted</option>
                    <option value="Initialized">Initialized</option>
                    <option value="Started">Started</option>
                    <option value="InProgress">In Progress</option>
                    <option value="Completed">Completed</option>
                  </select>
                  <br>
                  <label for="grade-gradingProgress"><b>Grading Progress: </b></label>
                  <select id="grade-gradingProgress" name="gradingProgress">
                    <option value="FullyGraded" selected>Fully Graded</option>
                    <option value="Pending">Pending</option>
                    <option value="PendingManual">Pending Manual</option>
                    <option value="Failed">Failed</option>
                    <option value="NotReady">Not Ready</option>
                  </select>
                  <br>
                  <input type="submit" value="Post Grade">
                </form>
              {% endif %}
              <h3>Create New Line Item</h3>
              <form method="POST" action="/instructor/lineitem/create">
                <label for="lineitem-label"><b>Label: </b></label>
                <input type="text" id="lineitem-label" name="label" required>
                <br>
                <label for="lineitem-scoreMaximum"><b>Max Score: </b></label>
                <input type="number" id="lineitem-scoreMaximum" name="scoreMaximum" step="any" required>
                <br>
                <label for="lineitem-resourceId"><b>Resource ID (optional): </b></label>
                <input type="text" id="lineitem-resourceId" name="resourceId">
                <br>
                <label for="lineitem-tag"><b>Tag (optional): </b></label>
                <input type="text" id="lineitem-tag" name="tag">
                <br>
                <label for="lineitem-startDateTime"><b>Start Date/Time (your local time, optional): </b></label>
                <input type="datetime-local" id="lineitem-startDateTime" name="startDateTime">
                <br>
                <label for="lineitem-endDateTime"><b>End Date/Time (your local time, optional): </b></label>
                <input type="datetime-local" id="lineitem-endDateTime" name="endDateTime">
                <br>
                <input type="submit" value="Create Line Item">
              </form>
            {% endif %}
          {% endif %}
        {% endif %}
        {% for courseId, course in courses %}
          <h2>{{ course.name }} ({{ course.label }})</h2>
          <p>
            <ul>
              <li><b>ID: </b> {{ courseId }}</li>
            </ul>
          </p>
          {% for assignmentId, assignment in course.assignments %}
            <h3>{{ assignment.name }}</h3>
            <p>
              <ul>
                <li><b>ID: </b> {{ assignmentId }}</li>
                <li><b>LTI 1.3 ID: </b> {{ assignment.lti_id }}</li>
                <li><b>Passback URL: </b> {{ assignment.grade_url }}</li>
              </ul>
            </p>
            {% for userId, grade in assignment.grades %}
              <h4>{{ grade.name | d("Anonymous Student", true) }} &lt;{{ grade.email | d("no email", true) }}&gt;</h4>
              <p>
                <ul>
                  <li><b>ID: </b> {{ userId }}</li>
                  <li><b>LTI 1.3 ID: </b> {{ grade.lis13_id }}</li>
                  <li><b>Outcome ID: </b> {{ grade.outcome_id }}</li>
                  <li><b>Current Score: </b>{{ grade.score }}</li>
                  <li>
                    <form method="POST" action="/instructor/grade">
                      <label for="grade"><b>Update Grade: </b></label>
                      <input type="number" id="grade" name="grade" min="0" max="1" step="0.01">
                      {% if launchData.launch_type == "lti1.3" %}
                      <br>
                      <label for="activityProgress"><b>Activity Progress: </b></label>
                      <select id="activityProgress" name="activityProgress">
                        <option value="Submitted" selected>Submitted</option>
                        <option value="Initialized">Initialized</option>
                        <option value="Started">Started</option>
                        <option value="InProgress">In Progress</option>
                        <option value="Completed">Completed</option>
                      </select>
                      <br>
                      <label for="gradingProgress"><b>Grading Progress: </b></label>
                      <select id="gradingProgress" name="gradingProgress">
                        <option value="FullyGraded" selected>Fully Graded</option>
                        <option value="Pending">Pending</option>
                        <option value="PendingManual">Pending Manual</option>
                        <option value="Failed">Failed</option>
                        <option value="NotReady">Not Ready</option>
                      </select>
                      <br>
                      {% endif %}
                      <input type="hidden" id="course" name="course" value="{{ courseId }}">
                      <input type="hidden" id="assignment" name="assignment" value="{{ assignmentId }}">
                      <input type="hidden" id="user" name="user" value="{{ userId }}">
                      <input type="submit" value="Submit">
                    </form>
                  </li>
                  {% if launchData.launch_type == "lti1.0" and grade.outcome_id %}
                  <li>
                    <form method="POST" action="/instructor/read-grade">
                      <input type="hidden" name="course" value="{{ courseId }}">
                      <input type="hidden" name="assignment" value="{{ assignmentId }}">
                      <input type="hidden" name="user" value="{{ userId }}">
                      <input type="submit" value="Read Grade from LMS">
                    </form>
                  </li>
                  <li>
                    <form method="POST" action="/instructor/delete-grade">
                      <input type="hidden" name="course" value="{{ courseId }}">
                      <input type="hidden" name="assignment" value="{{ assignmentId }}">
                      <input type="hidden" name="user" value="{{ userId }}">
                      <input type="submit" value="Delete Grade from LMS">
                    </form>
                  </li>
                  {% endif %}
                </ul>
              </p>
            {% else %}
              <p>No students found!</p>
            {% endfor %}
          {% else %}
            <p>No assignments found!</p>
          {% endfor %}
        {% else %}
          <p>No courses found!</p>
        {% endfor %}
        <hr />
        <details>
          <summary>LTI Debugging Information</summary>
          <p><b>LTI Launch Data</b></p>
          <pre>
{{ launchData | dump(2) | safe }}
          </pre>
          <p><b>LTI Consumer</b></p>
          <pre>
{{ consumer | dump(2) | safe }}
          </pre>
        </details>
    </main>
    <script>
      // Line item startDateTime/endDateTime inputs are "datetime-local" (no timezone attached) -
      // they always represent wall-clock time in the browser's own local timezone. The server only
      // ever stores/sends full ISO 8601 UTC strings, so conversion has to happen here, where the
      // real local timezone is actually known.

      // Format a Date's local wall-clock time as a "datetime-local" input value (YYYY-MM-DDTHH:mm).
      function toLocalDatetimeValue(date) {
        function pad(n) {
          return String(n).padStart(2, "0");
        }
        return (
          date.getFullYear() +
          "-" +
          pad(date.getMonth() + 1) +
          "-" +
          pad(date.getDate()) +
          "T" +
          pad(date.getHours()) +
          ":" +
          pad(date.getMinutes())
        );
      }

      // On load, convert each stored UTC value (in data-utc) into the viewer's local time for display.
      document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll("input[type='datetime-local'][data-utc]").forEach(function (input) {
          var utc = input.getAttribute("data-utc");
          if (utc) {
            input.value = toLocalDatetimeValue(new Date(utc));
          }
        });
      });

      // On submit, convert each local wall-clock value back to a full UTC ISO 8601 string.
      // A "datetime-local" input's value has no timezone suffix, so `new Date(...)` parses it
      // as local time (per the ECMAScript Date spec); `.toISOString()` then gives UTC.
      // Switching away from type="datetime-local" first is required because the browser
      // otherwise rejects any value that doesn't match its native picker format.
      document.addEventListener(
        "submit",
        function (event) {
          var form = event.target;
          if (!(form instanceof HTMLFormElement)) {
            return;
          }
          form.querySelectorAll("input[type='datetime-local']").forEach(function (input) {
            var value = input.value ? new Date(input.value).toISOString() : "";
            input.type = "text";
            input.value = value;
          });
        },
        true,
      );
    </script>
  </body>
</html>
